# ============================================================
# Enchanted Library — Environment Variables
# ============================================================
# 1. Copy this file and rename it to:  .env
# 2. Replace the placeholder values below with your real keys
# 3. Save the file — the run.ps1 script will load them automatically
# ============================================================

# Get your Groq API key for free at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Get your Pinecone API key for free at: https://app.pinecone.io
PINECONE_API_KEY=your_pinecone_api_key_here
